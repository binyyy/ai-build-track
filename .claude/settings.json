{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Edit(PROGRESS.md)",
      "Edit(.tutor/**)",
      "Edit(katas/**)",
      "Bash(python tools/due.py:*)",
      "Bash(python tools/health_metrics.py:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git checkout -b kata/*)",
      "Bash(git checkout -b regress/*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)"
    ],
    "deny": [
      "Edit(**/*.py)",
      "Edit(**/*.sql)",
      "Edit(**/prompts/**)",
      "Edit(**/.github/**)",
      "Edit(**/evals/adjudications/**)",
      "Edit(**/evals/graders/**)",
      "Read(**/.github/reviewer/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-handtyped.sh" }
        ]
      }
    ]
  }
}
